PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# How often (ms) gateway tags are polled and OEE is pushed to clients
POLL_INTERVAL_MS=2000
# Gateway source: "database" = read readings pushed into the tag_values table (gateway or Simulator page),
# "random" = in-memory random values without database writes
GATEWAY_MODE=database
# Ideal cycle rate used for Performance (pcs per minute)
IDEAL_RATE_PPM=60
# MySQL / MariaDB (XAMPP default: root without password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=OEE-URC-Cibitung
# Folder for uploaded files (SKU photos), served at /uploads
UPLOAD_DIR=uploads
